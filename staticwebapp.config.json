{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/icons/*",
      "/api/*",
      "*.{js,json,webmanifest,png,css}"
    ]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/config.js",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin"
  }
}